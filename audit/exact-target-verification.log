def Cycle13.CycleOrSingleEdge.{u} : {V : Type u} → SimpleGraph V → Set (Sym2 V) → Prop :=
fun {V} G s => (∃ v p, p.IsCycle ∧ s = p.edgeSet) ∨ ∃ e ∈ G.edgeSet, s = {e}
def Cycle13.EdgeDecomposition.{u} : {V : Type u} → SimpleGraph V → ℕ → Prop :=
fun {V} G k =>
  ∃ parts,
    (∀ (i : Fin k), Cycle13.CycleOrSingleEdge G (parts i)) ∧
      (Pairwise fun i j => Disjoint (parts i) (parts j)) ∧ ⋃ i, parts i = G.edgeSet
def Cycle13.componentCount.{u} : {V : Type u} → SimpleGraph V → ℕ :=
fun {V} G => Nat.card G.ConnectedComponent
