theorem terminal_layer_bound {m : ℕ} (hm : 2 ≤ m) {L : ℝ} (hL : 0 ≤ L)
    (S : Fin m → ℝ) (hS : ∀ i, 0 ≤ S i)
    (hboundary : ∀ i : Fin m, m ≤ i.val+2 → S i ≤ L*sequence (m-i.val))
    (hfold : ¬∃ i : Fin m, 0 < S i ∧ i.val+2 < m ∧
      (∑ j : Fin m with j.val ≤ i.val+2, S j) ≤ threshold (m-i.val)*S i) :
    (∑ i : Fin m with i.val+2 < m, S i) ≤
      L*((47862519299233493168422864174437615120855892599100621525752094172218238382892931600186794494268501467795395320649040822084836357143337/102418604209686700519337016549846223735512282839075511365413768108359751229436514595189879949444206797562395010492184417122682942947200 : ℝ)-Cycle12.sequenceTail sequence (m+1)) := by
  have h := Cycle12.terminal_mass_with_infinite_tail hm hL S hS sequence threshold
    (fun n => (positive n).le) (fun n _ => positive n) summable hboundary infinite_majorant hfold
  rw [terminal_mass] at h
