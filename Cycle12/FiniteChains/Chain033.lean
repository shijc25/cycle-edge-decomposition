theorem affine (hcover : ∀ (W : Type) [Fintype W] [DecidableEq W] (H : SimpleGraph W),
    FineCover H 2 ∧ CoarseCover H 1) :
    WeightedAffineBound (11022436051097/1000000000000) 121231198314424622156046266954170128263448363008 := by
  have h9 := terminalBound
  have h8 := stage8.step hcover h9
  have h7 := stage7.step hcover h8
  have h6 := stage6.step hcover h7
