def costBound : ℚ := (138172005771/12500000000)
theorem graph_bound (hcover : ∀ (W : Type) [Fintype W] [DecidableEq W] (H : SimpleGraph W),
    FineCover H 2 ∧ CoarseCover H 1)
    {V : Type} [Fintype V] [DecidableEq V] (G : SimpleGraph V)
    (hd : 2*G.edgeSet.ncard ≤ degreeCap*Fintype.card V) :
    ∃ P : CyclePacking G, P.weight ≤ (costBound:ℝ)*Fintype.card V := by
  exact finite_average_bound (by decide +kernel) (affine hcover)
    (by norm_num [degreeCap,costBound]) G hd

