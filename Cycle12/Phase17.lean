theorem terminal_layer_bound {m : ℕ} (hm : 2 ≤ m) {L : ℝ} (hL : 0 ≤ L)
    (S : Fin m → ℝ) (hS : ∀ i, 0 ≤ S i)
    (hboundary : ∀ i : Fin m, m ≤ i.val+2 → S i ≤ L*sequence (m-i.val))
    (hfold : ¬∃ i : Fin m, 0 < S i ∧ i.val+2 < m ∧
      (∑ j : Fin m with j.val ≤ i.val+2, S j) ≤ threshold (m-i.val)*S i) :
    (∑ i : Fin m with i.val+2 < m, S i) ≤
      L*((2296009647988430133803784030105719961599485034860148949966074126049634226464509910195789146268338202414302695955287072826692414641/5014719075781973417015985580175926599609563758037758049958475551891464882999029451224341098508323288064655705502654009086114946144 : ℝ)-Cycle12.sequenceTail sequence (m+1)) := by
  have h := Cycle12.terminal_mass_with_infinite_tail hm hL S hS sequence threshold
