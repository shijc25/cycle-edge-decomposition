      (∑ j : Fin m with j.val ≤ i.val+2, S j) ≤ threshold (m-i.val)*S i) :
    (∑ i : Fin m with i.val+2 < m, S i) ≤
      L*((46026000965894750536846607706270850204207498916390735037653034439195873312311610938180740456174928942939784412952737217/102495487724841770426702498983465704378547850555526956510483573495574704235187189697961692916807355373219518696651460020 : ℝ)-Cycle12.sequenceTail sequence (m+1)) := by
  have h := Cycle12.terminal_mass_with_infinite_tail hm hL S hS sequence threshold
