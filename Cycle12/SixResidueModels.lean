def sixResidueSlot : Fin 14 → Fin 4 → Option (Fin 11) :=
  ![![some 0,some 3,some 6,none],
    ![some 1,some 3,some 6,none],
    ![some 0,some 4,some 6,none],
    ![some 1,some 4,some 6,none],
    ![some 1,some 4,some 7,none],
    ![some 2,some 4,some 7,none],
    ![some 1,some 5,some 7,none],
    ![some 2,some 5,some 7,none],
    ![some 0,some 2,some 8,none],
    ![some 0,some 3,some 8,none],
    ![some 2,some 5,some 8,none],
    ![some 3,some 5,some 8,none],
    ![some 0,some 2,some 4,some 9],
    ![some 1,some 3,some 5,some 10]]

def sixResidueSlotVertex (j : Fin 4) (k : Fin 2) : Fin 16 :=
  ⟨6+2*j.val+k.val,by omega⟩

def sixResidueCore (i : Fin 6) : Fin 16 := ⟨i.val,by omega⟩

def sixResidueRing : Finset (Sym2 (Fin 16)) := {s(0,1),s(0,5),s(1,2),s(2,3),s(3,4),s(4,5)}

def sixResidueChord : Fin 9 → Sym2 (Fin 16) := ![s(0,2),s(0,3),s(0,4),s(1,3),s(1,4),s(1,5),s(2,4),s(2,5),s(3,5)]

def sixResidueSpokes (t : Fin 14) (counts : Fin 4 → Fin 3) : Finset (Sym2 (Fin 16)) :=
  univ.biUnion fun j => univ.biUnion fun k : Fin 2 =>
    if k.val < (counts j).val then
      match sixResidueSlot t j with
      | none => ∅
      | some i => (sixAttachment i).image (fun v => s(sixResidueSlotVertex j k,sixResidueCore v))
    else ∅

def sixResidueEar (ear : Fin 5) : Finset (Sym2 (Fin 16)) :=
  ![∅,{s(0,14),s(14,15),s(3,15)},
    {s(0,14),s(14,15),s(3,15),s(3,14)},
    {s(0,14),s(14,15),s(3,15),s(0,15)},
    {s(0,14),s(14,15),s(3,15),s(3,14),s(0,15)}] ear

def sixResidueActive (counts : Fin 4 → Fin 3) (ear : Fin 5) : Finset (Fin 16) :=
  (univ.image sixResidueCore) ∪
    (univ.biUnion fun j => ((univ : Finset (Fin 2)).filter
      (fun k => k.val < (counts j).val)).image (sixResidueSlotVertex j)) ∪
    (if ear=0 then ∅ else {14,15})

def sixResidueBase (t : Fin 14) (counts : Fin 4 → Fin 3) (ear : Fin 5) :
    Finset (Sym2 (Fin 16)) := sixResidueRing ∪ sixResidueSpokes t counts ∪ sixResidueEar ear

def SixResidueParametersValid (t : Fin 14) (counts : Fin 4 → Fin 3) (ear : Fin 5) : Prop :=
  (ear≠0 → t.val<4) ∧ ∀ j, match sixResidueSlot t j with
    | none => counts j=0
    | some i => (counts j).val ≤ if i.val<9 then 1 else 2

instance (t : Fin 14) (counts : Fin 4 → Fin 3) (ear : Fin 5) :
    Decidable (SixResidueParametersValid t counts ear) := by
  letI (j : Fin 4) : Decidable (match sixResidueSlot t j with
      | none => counts j=0
      | some i => (counts j).val ≤ if i.val<9 then 1 else 2) := by
    cases sixResidueSlot t j <;> infer_instance
  unfold SixResidueParametersValid
  infer_instance

