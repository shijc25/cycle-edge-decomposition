  · exact fun n _ => Cycle12.Phase36.positive n
  · exact Cycle12.Phase36.summable
  · exact Cycle12.Phase36.infinite_majorant
  · exact hfold

theorem actual_degree {G : SimpleGraph V} (L : ScaleLayers12 G)
