theorem actual_kept_mass {G : SimpleGraph V} (L : ScaleLayers12 G)
    (hphase : lo ≤ theta2^L.stopIndex*originalLog V)
    (hfold : ¬∃ i : Fin (L.stopIndex+3), 0 < L.coreMass i.val ∧ i.val+2 < L.stopIndex+3 ∧
      (∑ j : Fin (L.stopIndex+3) with j.val ≤ i.val+2, L.coreMass j.val) ≤
        Cycle12.Phase04.threshold (L.stopIndex+3-i.val)*L.coreMass i.val) :
    vertexMass (pastPieces L.splitter 0 (L.stopIndex+1) [originalPiece G]) ≤
      (Fintype.card V:ℝ)*(sequenceTail Cycle12.Phase04.sequence 3-
        sequenceTail Cycle12.Phase04.sequence (L.stopIndex+4)) := by
  apply L.kept_mass_of_no_fold (by norm_num [lo]) hphase masses.1 masses.2.2.1
    Cycle12.Phase04.sequence Cycle12.Phase04.threshold
  · have he : Cycle12.Phase04.sequence 1=mass1 := by
      norm_num [Cycle12.Phase04.sequence,splice,Cycle12.Phase04.initial,mass1]
    rw [he]
    exact masses.2.1
  · have he : Cycle12.Phase04.sequence 2=mass2 := by
      norm_num [Cycle12.Phase04.sequence,splice,Cycle12.Phase04.initial,mass2]
    rw [he]
    exact masses.2.2.2.1
  · exact fun n => (Cycle12.Phase04.positive n).le
  · exact fun n _ => Cycle12.Phase04.positive n
  · exact Cycle12.Phase04.summable
  · exact Cycle12.Phase04.infinite_majorant
  · exact hfold

theorem actual_degree {G : SimpleGraph V} (L : ScaleLayers12 G)
    (hphase : lo ≤ theta2^L.stopIndex*originalLog V)
    (hupper : theta2^L.stopIndex*originalLog V ≤ hi) :
    2*(edgeCount (stoppedRemainder L):ℝ) ≤ (2:ℝ)^cutoff*Fintype.card V := by
  have hh := stopped_phase_degree L (by norm_num [lo]) hphase hupper masses.2.2.2.2.1
  have hm := mul_le_mul_of_nonneg_right masses.2.2.2.2.2
    (rpow_nonneg (by norm_num : (0:ℝ)≤2) (theta2*hi))
  exact hh.trans (mul_le_mul_of_nonneg_right (hm.trans phase_degree_cap) (Nat.cast_nonneg _))

theorem actual_cycle_fee {G : SimpleGraph V} (L : ScaleLayers12 G)
    (hphase : lo ≤ theta2^L.stopIndex*originalLog V) :
