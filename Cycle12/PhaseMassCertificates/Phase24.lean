    vertexMass (pastPieces L.splitter 0 (L.stopIndex+1) [originalPiece G]) ≤
      (Fintype.card V:ℝ)*(sequenceTail Cycle12.Phase24.sequence 3-
        sequenceTail Cycle12.Phase24.sequence (L.stopIndex+4)) := by
