  · exact fun n => (Cycle12.Phase09.positive n).le
  · exact fun n _ => Cycle12.Phase09.positive n
  · exact Cycle12.Phase09.summable
  · exact Cycle12.Phase09.infinite_majorant
  · exact hfold

theorem actual_degree {G : SimpleGraph V} (L : ScaleLayers12 G)
