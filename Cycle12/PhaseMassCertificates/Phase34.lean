  have hm := mul_le_mul_of_nonneg_right masses.2.2.2.2.2
    (rpow_nonneg (by norm_num : (0:ℝ)≤2) (theta2*hi))
  exact hh.trans (mul_le_mul_of_nonneg_right (hm.trans phase_degree_cap) (Nat.cast_nonneg _))

