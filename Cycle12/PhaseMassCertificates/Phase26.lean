  · exact fun n => (Cycle12.Phase26.positive n).le
  · exact fun n _ => Cycle12.Phase26.positive n
  · exact Cycle12.Phase26.summable
  · exact Cycle12.Phase26.infinite_majorant
  · exact hfold

theorem actual_degree {G : SimpleGraph V} (L : ScaleLayers12 G)
    (hphase : lo ≤ theta2^L.stopIndex*originalLog V)
