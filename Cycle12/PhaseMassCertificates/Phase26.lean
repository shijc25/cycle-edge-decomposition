        Cycle12.Phase26.threshold (L.stopIndex+3-i.val)*L.coreMass i.val) :
    vertexMass (pastPieces L.splitter 0 (L.stopIndex+1) [originalPiece G]) ≤
      (Fintype.card V:ℝ)*(sequenceTail Cycle12.Phase26.sequence 3-
        sequenceTail Cycle12.Phase26.sequence (L.stopIndex+4)) := by
  apply L.kept_mass_of_no_fold (by norm_num [lo]) hphase masses.1 masses.2.2.1
    Cycle12.Phase26.sequence Cycle12.Phase26.threshold
  · have he : Cycle12.Phase26.sequence 1=mass1 := by
      norm_num [Cycle12.Phase26.sequence,splice,Cycle12.Phase26.initial,mass1]
    rw [he]
    exact masses.2.1
  · have he : Cycle12.Phase26.sequence 2=mass2 := by
      norm_num [Cycle12.Phase26.sequence,splice,Cycle12.Phase26.initial,mass2]
    rw [he]
