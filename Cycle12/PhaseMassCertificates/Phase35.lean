theorem actual_kept_mass {G : SimpleGraph V} (L : ScaleLayers12 G)
    (hphase : lo ≤ theta2^L.stopIndex*originalLog V)
    (hfold : ¬∃ i : Fin (L.stopIndex+3), 0 < L.coreMass i.val ∧ i.val+2 < L.stopIndex+3 ∧
      (∑ j : Fin (L.stopIndex+3) with j.val ≤ i.val+2, L.coreMass j.val) ≤
        Cycle12.Phase35.threshold (L.stopIndex+3-i.val)*L.coreMass i.val) :
    vertexMass (pastPieces L.splitter 0 (L.stopIndex+1) [originalPiece G]) ≤
      (Fintype.card V:ℝ)*(sequenceTail Cycle12.Phase35.sequence 3-
        sequenceTail Cycle12.Phase35.sequence (L.stopIndex+4)) := by
  apply L.kept_mass_of_no_fold (by norm_num [lo]) hphase masses.1 masses.2.2.1
    Cycle12.Phase35.sequence Cycle12.Phase35.threshold
  · have he : Cycle12.Phase35.sequence 1=mass1 := by
      norm_num [Cycle12.Phase35.sequence,splice,Cycle12.Phase35.initial,mass1]
    rw [he]
    exact masses.2.1
  · have he : Cycle12.Phase35.sequence 2=mass2 := by
      norm_num [Cycle12.Phase35.sequence,splice,Cycle12.Phase35.initial,mass2]
    rw [he]
    exact masses.2.2.2.1
  · exact fun n => (Cycle12.Phase35.positive n).le
  · exact fun n _ => Cycle12.Phase35.positive n
  · exact Cycle12.Phase35.summable
  · exact Cycle12.Phase35.infinite_majorant
  · exact hfold

theorem actual_degree {G : SimpleGraph V} (L : ScaleLayers12 G)
    (hphase : lo ≤ theta2^L.stopIndex*originalLog V)
    (hupper : theta2^L.stopIndex*originalLog V ≤ hi) :
    2*(edgeCount (stoppedRemainder L):ℝ) ≤ (2:ℝ)^cutoff*Fintype.card V := by
