        Cycle12.Phase19.threshold (L.stopIndex+3-i.val)*L.coreMass i.val) :
    vertexMass (pastPieces L.splitter 0 (L.stopIndex+1) [originalPiece G]) ≤
      (Fintype.card V:ℝ)*(sequenceTail Cycle12.Phase19.sequence 3-
        sequenceTail Cycle12.Phase19.sequence (L.stopIndex+4)) := by
