/-- Uniform kernel verification of all 512 chord choices, including edge accounting. -/
theorem six_core_table_checked : ∀ S : Finset (Fin 9),
    (sixCoreData[sixCoreMask S]!).Checks (sixCoreEdges S) := by decide +kernel

theorem six_core_no_diagonal : ∀ S : Finset (Fin 9), ∀ e∈sixCoreEdges S, ¬e.IsDiag := by
  decide +kernel

theorem terminal_six_core_model (S : Finset (Fin 9)) :
    ∃ P : Cycle13.CyclePacking (TerminalCert.graph (sixCoreEdges S)),
      P.cost ≤ 19*(6-1)+6*(TerminalCert.graph (sixCoreEdges S)).edgeSet.ncard := by
  have hshort : Cycle13.NoCycleAtLeast (TerminalCert.graph (sixCoreEdges S)) 7 := by
    intro u c hc
    have hh := Cycle13.cycle_length_le_order hc
    simp only [Fintype.card_fin] at hh
    omega
  obtain ⟨P,hP⟩ := (sixCoreData[sixCoreMask S]!).sound
    (sixCoreEdges S) (six_core_table_checked S) hshort
  refine ⟨P,?_⟩
  rw [TerminalCert.edgeSet_graph _ (six_core_no_diagonal S),Set.ncard_coe_finset]
  simpa only [Fintype.card_fin] using hP

end Cycle12
