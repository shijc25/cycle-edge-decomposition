theorem six_residue_certificate_parameters (t : Fin 14) (counts : Fin 4 → Fin 3)
    (ear : Fin 5) (hvalid : SixResidueParametersValid t counts ear) (S : Finset (Fin 9)) :
    ∃ c : DecisionCertificate (Fin 16), c.ChecksAt
      (chordEdges (sixResidueBase t counts ear) sixResidueChord S)
      (19*((sixResidueActive counts ear).card-1)+
        6*(chordEdges (sixResidueBase t counts ear) sixResidueChord S).card) := by
  have hh := six_residue_certificate (sixResidueParameterIndex t counts ear) S
  simpa only [sixResidueBaseAt,sixResidueActiveAt,six_residue_parameter_coverage t counts ear hvalid] using hh

noncomputable section
attribute [local instance] Classical.propDecidable

/-- Closed terminal theorem for every certified finite residue, including
all chord choices and with the exact order of the active vertex set. -/
theorem terminal_six_residue_model (t : Fin 14) (counts : Fin 4 → Fin 3)
    (ear : Fin 5) (hvalid : SixResidueParametersValid t counts ear) (S : Finset (Fin 9))
    (hshort : Cycle13.NoCycleAtLeast ((graph (chordEdges
      (sixResidueBase t counts ear) sixResidueChord S)).induce
        (sixResidueActive counts ear : Set (Fin 16))) 7) :
    ∃ P : Cycle13.CyclePacking ((graph (chordEdges
      (sixResidueBase t counts ear) sixResidueChord S)).induce
        (sixResidueActive counts ear : Set (Fin 16))),
      P.cost ≤ 19*(Fintype.card (sixResidueActive counts ear : Set (Fin 16))-1)+
        6*((graph (chordEdges (sixResidueBase t counts ear) sixResidueChord S)).induce
          (sixResidueActive counts ear : Set (Fin 16))).edgeSet.ncard := by
  obtain ⟨c,hc⟩ := six_residue_certificate_parameters t counts ear hvalid S
  exact c.soundSupported _ _ (fun e he => (six_residue_edges_facts t counts ear S e he).1)
    (six_residue_edges_supported t counts ear S) hc hshort

end
end Cycle12
