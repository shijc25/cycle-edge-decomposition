      (∑ j : Fin m with j.val ≤ i.val+2, S j) ≤ threshold (m-i.val)*S i) :
    (∑ i : Fin m with i.val+2 < m, S i) ≤
      L*((145666929755954719773904889698240381112379295953332681735640783303696875957162484984364657059672474086365857589730878027341507477382131/314438819989323792123129477224806819615227317242954800326325497185076000774576709775726638238973049494268074377320189035770179755573000 : ℝ)-Cycle12.sequenceTail sequence (m+1)) := by
  have h := Cycle12.terminal_mass_with_infinite_tail hm hL S hS sequence threshold
