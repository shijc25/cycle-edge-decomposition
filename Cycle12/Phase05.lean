def sequence : ℕ → ℝ := Cycle12.splice r 17 initial

theorem r_bounds : 0 < r ∧ r < 1 := by norm_num [r]

theorem finite_positive (n : ℕ) (hn : n < 17) : 0 < initial n := by
  interval_cases n <;> norm_num [initial]

theorem tail_coefficient : 1 ≤ threshold 16*Cycle1249.prefixH r := by
  norm_num [threshold,r,Cycle1249.prefixH]

theorem threshold_tail (n : ℕ) (hn : 17 ≤ n) : threshold 16 ≤ threshold n := by
  simp [threshold,show ¬n ≤ 15 by omega]

theorem finite_majorant (n : ℕ) (hn : 2 < n) (hn1 : n < 17) :
    (∑ j ∈ range (17-n), initial (j+(n-2)))+
      (r*initial 15+initial 16)/r^2 ≤ threshold n*initial n := by
  interval_cases n <;> norm_num [initial,threshold,r,Finset.sum_range_succ]

theorem positive (n : ℕ) : 0 < sequence n := by
  exact Cycle12.splice_pos (by norm_num) r_bounds.1 r_bounds.2 finite_positive n

theorem summable : Summable sequence := by
  exact Cycle12.splice_summable (by norm_num) r_bounds.1 r_bounds.2
    (finite_positive 15 (by norm_num)) (finite_positive 16 (by norm_num))

theorem infinite_majorant (n : ℕ) (hn : 2 < n) :
    (∑' j : ℕ, sequence (j+(n-2))) ≤ threshold n*sequence n := by
  exact Cycle12.splice_infinite_majorant (by norm_num) initial threshold
    r_bounds.1 r_bounds.2 (finite_positive 15 (by norm_num))
    (finite_positive 16 (by norm_num)) tail_coefficient threshold_tail finite_majorant n hn

theorem terminal_mass : Cycle12.sequenceTail sequence 3 = (1591701473265410936143029413446613169567164634123139931094902525307603736165713581987944495134702777489225065456372759200180353/3280115614982147929885414701499485990255813381787873399294400995481611373675894028611238868439384287675609904328341098325767075 : ℝ) := by
  unfold Cycle12.sequenceTail sequence
  rw [Cycle12.splice_finite_tail_sum (by norm_num) r_bounds.1 r_bounds.2
    (finite_positive 15 (by norm_num)) (finite_positive 16 (by norm_num)) (by norm_num)]
  norm_num [initial,r,Finset.sum_range_succ]

theorem terminal_layer_bound {m : ℕ} (hm : 2 ≤ m) {L : ℝ} (hL : 0 ≤ L)
    (S : Fin m → ℝ) (hS : ∀ i, 0 ≤ S i)
    (hboundary : ∀ i : Fin m, m ≤ i.val+2 → S i ≤ L*sequence (m-i.val))
    (hfold : ¬∃ i : Fin m, 0 < S i ∧ i.val+2 < m ∧
      (∑ j : Fin m with j.val ≤ i.val+2, S j) ≤ threshold (m-i.val)*S i) :
    (∑ i : Fin m with i.val+2 < m, S i) ≤
      L*((1591701473265410936143029413446613169567164634123139931094902525307603736165713581987944495134702777489225065456372759200180353/3280115614982147929885414701499485990255813381787873399294400995481611373675894028611238868439384287675609904328341098325767075 : ℝ)-Cycle12.sequenceTail sequence (m+1)) := by
  have h := Cycle12.terminal_mass_with_infinite_tail hm hL S hS sequence threshold
    (fun n => (positive n).le) (fun n _ => positive n) summable hboundary infinite_majorant hfold
  rw [terminal_mass] at h
  exact h

