      (∑ j : Fin m with j.val ≤ i.val+2, S j) ≤ threshold (m-i.val)*S i) :
    (∑ i : Fin m with i.val+2 < m, S i) ≤
      L*((3629562263118219720187170251233996549487463310398435798615064200791254037968918642989243352862101527785492776479128103152967/7983196689235466504086529863608424584394618864736665222972281535079594950241752230660598893349589790728100321952473098510900 : ℝ)-Cycle12.sequenceTail sequence (m+1)) := by
  have h := Cycle12.terminal_mass_with_infinite_tail hm hL S hS sequence threshold
