      L*((939562614668561567440084981653232478561050820294000022441420422151570604758013844029792562066527366167788196445987987583187/2119427050197090454523948804807723387622589467548728597968946790945044461702461928195036949657618597945679017737501103535200 : ℝ)-Cycle12.sequenceTail sequence (m+1)) := by
