theorem terminal_layer_bound {m : ℕ} (hm : 2 ≤ m) {L : ℝ} (hL : 0 ≤ L)
    (S : Fin m → ℝ) (hS : ∀ i, 0 ≤ S i)
    (hboundary : ∀ i : Fin m, m ≤ i.val+2 → S i ≤ L*sequence (m-i.val))
