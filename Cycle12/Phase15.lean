      (∑ j : Fin m with j.val ≤ i.val+2, S j) ≤ threshold (m-i.val)*S i) :
    (∑ i : Fin m with i.val+2 < m, S i) ≤
      L*((34614528057996600403634221598875997298549021773594967174324395760909555032951814527857840990860990871268107380798068061711264526281/75025252052700492782908788544179156824236336345373902602260389304131665763030455399535240188157192318113784837756328999784618301900 : ℝ)-Cycle12.sequenceTail sequence (m+1)) := by
