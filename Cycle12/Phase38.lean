      L*((119565104388903260496398856827926589294846748231541895633615278400287447313832300782350014815096980991804188936784008746872779/272035187444187127902815747947669280291527152859164314866376245101405868723129373594772371977381257150339641052207907395724800 : ℝ)-Cycle12.sequenceTail sequence (m+1)) := by
