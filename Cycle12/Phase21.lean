def sequence : ℕ → ℝ := Cycle12.splice r 17 initial

theorem r_bounds : 0 < r ∧ r < 1 := by norm_num [r]

theorem finite_positive (n : ℕ) (hn : n < 17) : 0 < initial n := by
  interval_cases n <;> norm_num [initial]

theorem tail_coefficient : 1 ≤ threshold 16*Cycle1249.prefixH r := by
  norm_num [threshold,r,Cycle1249.prefixH]

theorem threshold_tail (n : ℕ) (hn : 17 ≤ n) : threshold 16 ≤ threshold n := by
  simp [threshold,show ¬n ≤ 15 by omega]

theorem finite_majorant (n : ℕ) (hn : 2 < n) (hn1 : n < 17) :
    (∑ j ∈ range (17-n), initial (j+(n-2)))+
      (r*initial 15+initial 16)/r^2 ≤ threshold n*initial n := by
  interval_cases n <;> norm_num [initial,threshold,r,Finset.sum_range_succ]

theorem positive (n : ℕ) : 0 < sequence n := by
  exact Cycle12.splice_pos (by norm_num) r_bounds.1 r_bounds.2 finite_positive n

theorem summable : Summable sequence := by
  exact Cycle12.splice_summable (by norm_num) r_bounds.1 r_bounds.2
    (finite_positive 15 (by norm_num)) (finite_positive 16 (by norm_num))

theorem infinite_majorant (n : ℕ) (hn : 2 < n) :
    (∑' j : ℕ, sequence (j+(n-2))) ≤ threshold n*sequence n := by
  exact Cycle12.splice_infinite_majorant (by norm_num) initial threshold
    r_bounds.1 r_bounds.2 (finite_positive 15 (by norm_num))
    (finite_positive 16 (by norm_num)) tail_coefficient threshold_tail finite_majorant n hn

theorem terminal_mass : Cycle12.sequenceTail sequence 3 = (57336333830756257648886203899529090929527821490157219155422227179304520404145160624228937535920422340846782998644512629729/126927071185395523030411651541176617839146559416139208803876591003560222051863755364856997680196282278932722623783672792500 : ℝ) := by
