      (∑ j : Fin m with j.val ≤ i.val+2, S j) ≤ threshold (m-i.val)*S i) :
    (∑ i : Fin m with i.val+2 < m, S i) ≤
      L*((2282666889893350308829192330871032394546791480887357911892230643701883519889985000895098101702999521114590433572305478959659559/5191026753802935770185736095510515904565050875829743387179344927392794725782249306579029258017035751259142526128507099301993100 : ℝ)-Cycle12.sequenceTail sequence (m+1)) := by
  have h := Cycle12.terminal_mass_with_infinite_tail hm hL S hS sequence threshold
