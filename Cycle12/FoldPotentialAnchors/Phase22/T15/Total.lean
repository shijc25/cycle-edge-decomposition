import Cycle12.FoldPotentialAnchors.Phase22.T15.Point00

namespace Cycle12.Global12.FoldAnchors.Phase22.T15
open Real Finset
noncomputable section

def upper : ℕ → ℝ
  | 0 => (((271931/200000000000000000000000):ℚ):ℝ)
  | _ => 0

theorem point (j : ℕ) (hj : j ≤ 0) : lossH (((():ℚ):ℝ)/b^j) ≤ upper j := by
  interval_cases j
  · have he : ((():ℚ):ℝ)/b^0=((():ℚ):ℝ) := by norm_num [b]
    rw [he]
    exact Point00.actual_loss_bound

theorem loss_bound : globalLoss ((():ℚ):ℝ) ≤ (((271931/100000000000000000000000):ℚ):ℝ) := by
  have hw : wA ≤ ((():ℚ):ℝ) := by norm_num [wA]
  have hh := globalLoss_half_tail hw 0 (by norm_num [lossRate,eps,theta2,b])
  have he : b*((():ℚ):ℝ)=((():ℚ):ℝ) := by norm_num [b]
  rw [he] at hh
  have hs : (∑ j∈range 0,lossH (((():ℚ):ℝ)/b^j)) ≤ ∑ j∈range 0,upper j := by
    apply sum_le_sum
    intro j hj
    exact point j (by have := mem_range.mp hj; omega)
  have ht := point 0 le_rfl
  calc
    _  ≤  (∑ j∈range 0,lossH (((():ℚ):ℝ)/b^j))+2*lossH (((():ℚ):ℝ)/b^0) := hh
    _  ≤  (∑ j∈range 0,upper j)+2*upper 0 := by linarith only [hs,ht]
    _  ≤  _ := by norm_num [upper,sum_range_succ]

end
end Cycle12.Global12.FoldAnchors.Phase22.T15
