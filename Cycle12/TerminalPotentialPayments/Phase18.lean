theorem budget : (FiniteChains.Chain026.costBound:ℝ)+(1+C*eta)*terminalTotal+cycleFee ≤ C := by
  norm_num [FiniteChains.Chain026.costBound,C,eta,terminalTotal,cycleFee]

theorem numerical_payment (m : ℕ) (hm : 3  ≤  m) (hm1 : m ≤ 16) :
    C*lossValue m+(if m<15 then
      (FiniteChains.Chain026.costBound:ℝ)+(1+C*eta)*terminalTotal+cycleFee-C else 0) ≤ 
        (1+C*eta)*tailValue m := by
  interval_cases m <;> norm_num [C,eta,FiniteChains.Chain026.costBound,terminalTotal,
    cycleFee,lossValue,tailValue]

theorem infinite_decay : (2:ℝ)^(-(lossRate/b)*(lo/theta2^12)*(theta2⁻¹^2-1)) ≤ 
    Cycle12.Phase18.r*(1-Cycle12.Phase18.r) := by
  calc
    _  ≤  (2:ℝ)^(-4:ℝ) := rpow_le_rpow_of_exponent_le (by norm_num)
      (by norm_num [lossRate,b,eps,theta2,lo])
    _  ≤  _ := by norm_num [Cycle12.Phase18.r]

theorem scalar_payment (m : ℕ) (hm : 3  ≤  m) :
    (FiniteChains.Chain026.costBound:ℝ)+
      (1+C*eta)*(sequenceTail Cycle12.Phase18.sequence 3-
        sequenceTail Cycle12.Phase18.sequence (m+1))+cycleFee ≤ C*globalPhi (lo/theta2^(m-3)) := by
  apply terminal_potential_payment Cycle12.Phase18.sequence
    (beta:=Cycle12.Phase18.r*(1-Cycle12.Phase18.r))
    (by norm_num [wA,lo]) (by norm_num [Cycle12.Phase18.r])
  · rw [terminal_total]
    exact budget
  · intro k hk hk1
    rw [terminal_total,tail_value k hk (by omega)]
    have hl := mul_le_mul_of_nonneg_left (loss_value k hk (by omega)) (show 0 ≤ C by norm_num [C])
    have hp := numerical_payment k hk (by omega)
    rw [ite_eq_left hk1] at hp
    linarith only [hp,hl]
  · exact infinite_decay
  · intro k hk
    exact splice_tail_two_step (N:=17) (by omega) Cycle12.Phase18.r_bounds.2.le
      Cycle12.Phase18.summable (fun n => (Cycle12.Phase18.positive n).le) hk
  · have hl := mul_le_mul_of_nonneg_left (loss_value 15 (by omega) (by omega)) (show 0 ≤ C by norm_num [C])
    have hp := numerical_payment 15 (by omega) (by omega)
    rw [show sequenceTail Cycle12.Phase18.sequence 16=tailValue 15 from tail_value 15 (by omega) (by omega)]
    rw [ite_eq_right (show ¬(15:ℕ)<15 by omega),add_zero] at hp
    exact hl.trans hp
  · have hl := mul_le_mul_of_nonneg_left (loss_value 16 (by omega) (by omega)) (show 0 ≤ C by norm_num [C])
    have hp := numerical_payment 16 (by omega) (by omega)
    rw [show sequenceTail Cycle12.Phase18.sequence 17=tailValue 16 from tail_value 16 (by omega) (by omega)]
    rw [ite_eq_right (show ¬(16:ℕ)<15 by omega),add_zero] at hp
    exact hl.trans hp
  · exact hm

variable {V : Type} [Fintype V] [DecidableEq V]

/-- The complete actual no-fold branch for this phase, including the
infinite terminal payment and an explicit strictly smaller-order IH. -/
theorem actual_terminal {G : SimpleGraph V} (L : Cycle12.Even12.EvenScaleLayers12 G)
    (ih : ∀ n,n<Fintype.card V → ∀ H : SimpleGraph (Fin n),
      ∃ Q : CyclePacking H,Q.weight ≤ C*n)
    (hphase : lo ≤ theta2^L.stopIndex*originalLog V)
    (hupper : theta2^L.stopIndex*originalLog V ≤ hi)
    (hfold : ¬∃ i : Fin (L.stopIndex+3),0<L.coreMass i.val ∧ i.val+2<L.stopIndex+3 ∧
      (∑ j : Fin (L.stopIndex+3) with j.val ≤ i.val+2,L.coreMass j.val) ≤ 
        Cycle12.Phase18.threshold (L.stopIndex+3-i.val)*L.coreMass i.val) :
    ∃ Q : CyclePacking G,Q.weight ≤ C*orderPotential (Fintype.card V)*Fintype.card V := by
  obtain ⟨Q,hQ⟩ := Cycle12.Even12.Phase18.terminal_no_fold L ih hphase hupper hfold
  have hs := scalar_payment (L.stopIndex+3) (by omega)
  simp only [Nat.add_sub_cancel] at hs
  have hx : lo/theta2^L.stopIndex ≤ originalLog V :=
    (div_le_iff₀ (pow_pos (by norm_num [theta2]) _)).mpr (by simpa only [mul_comm] using hphase)
  have hp := mul_le_mul_of_nonneg_left (globalPhi_monotone hx) (show 0 ≤ C by norm_num [C])
  exact ⟨Q,hQ.trans (mul_le_mul_of_nonneg_right (hs.trans hp) (Nat.cast_nonneg _))⟩

end
