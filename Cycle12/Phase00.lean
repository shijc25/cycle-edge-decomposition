      (∑ j : Fin m with j.val ≤ i.val+2, S j) ≤ threshold (m-i.val)*S i) :
    (∑ i : Fin m with i.val+2 < m, S i) ≤
      L*((118884580261870952021722879252418668848373131561804055460736522076861803049549264862680845170194082733674725392245453268572638384031/236391205571788398213256067504178222383243094763937089484578147477206127834411064498327898296564009091732236302328653461341415060200 : ℝ)-Cycle12.sequenceTail sequence (m+1)) := by
  have h := Cycle12.terminal_mass_with_infinite_tail hm hL S hS sequence threshold
