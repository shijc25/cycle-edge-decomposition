    (∑ i : Fin m with i.val+2 < m, S i) ≤
      L*((70757792082576194105744763319200853570086574174620759560854231824418911966079373542620802708442526945123265606828381815259/158841960120795482553297656245239077708283580721470990782779578138264813967981841226719038863581589707945448505415953602160 : ℝ)-Cycle12.sequenceTail sequence (m+1)) := by
