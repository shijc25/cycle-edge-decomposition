      (∑ j : Fin m with j.val ≤ i.val+2, S j) ≤ threshold (m-i.val)*S i) :
    (∑ i : Fin m with i.val+2 < m, S i) ≤
      L*((10280791412617069704508161736785898489067395460636510071541732246998867961636507219309408283166414402803929232985453976359559/22827911994367240697571038869856822723466713465514474624594411618063618387773189997748370168804611791584882515659269881456600 : ℝ)-Cycle12.sequenceTail sequence (m+1)) := by
