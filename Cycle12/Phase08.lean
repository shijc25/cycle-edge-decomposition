      (∑ j : Fin m with j.val ≤ i.val+2, S j) ≤ threshold (m-i.val)*S i) :
    (∑ i : Fin m with i.val+2 < m, S i) ≤
      L*((3989190738553643874687973179672557756827367782422488779924778380780134896538980389021159289699952995544170485128198829489453149/8367121103879279740858681102609427905916987235956074448193412751553115756483132978751331059814540623342748297016916737472597000 : ℝ)-Cycle12.sequenceTail sequence (m+1)) := by
  have h := Cycle12.terminal_mass_with_infinite_tail hm hL S hS sequence threshold
