      (∑ j : Fin m with j.val ≤ i.val+2, S j) ≤ threshold (m-i.val)*S i) :
    (∑ i : Fin m with i.val+2 < m, S i) ≤
      L*((1491160204650117208300520330679873750426632387515088462706665237293530027344906952927526401363955807575545216335534331140761/3392643295810125168064896380150888733600156765701671373501432537679628712907571952471077617675884133476175203540464742073100 : ℝ)-Cycle12.sequenceTail sequence (m+1)) := by
  have h := Cycle12.terminal_mass_with_infinite_tail hm hL S hS sequence threshold
